{
  "expo": {
    "name": "Face Attendance",
    "slug": "face-attendance",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/image.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/image.png",
      "resizeMode": "contain",
      "backgroundColor": "#090d16"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.umerfarooqlaghari.faceattendance",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "Face Attendance requires camera access to scan and verify employee faces for attendance clock-in.",
        "NSLocationWhenInUseUsageDescription": "Face Attendance requires your location to verify clock-in at the authorized job site.",
        "UIBackgroundModes": [
          "remote-notification"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#090d16",
        "foregroundImage": "./assets/image.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/image.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.umerfarooqlaghari.faceattendance",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/image.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-camera",
      "expo-location",
      [
        "expo-notifications",
        {
          "icon": "./assets/image.png",
          "color": "#0284c7"
        }
      ]
    ],
    "owner": "umer.farooq",
    "extra": {
      "eas": {
        "projectId": "1bdb6314-0681-4b94-984b-bf34b81be5d8"
      }
    }
  }
}
